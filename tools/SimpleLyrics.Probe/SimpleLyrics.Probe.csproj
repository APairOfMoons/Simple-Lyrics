<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SimpleLyrics.Probe —— P0 验证 / 诊断用的命令行工具。
    用于验证 PLAN.md §5「假设 A」：Windows Media Foundation 能否解码目标格式，
    以及后续的 seek 精度、峰值生成性能测量。
    不参与产品运行时，仅开发期使用。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SimpleLyrics.Probe</RootNamespace>
    <AssemblyName>SimpleLyrics.Probe</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- FFmpeg.AutoGen 绑定全部是指针 API，必须开启 unsafe。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="$(NAudioVersion)" />
    <PackageReference Include="FFmpeg.AutoGen" Version="$(FFmpegAutoGenVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 探针直接验证产品代码（解码器与峰值生成），而不是另写一份等价实现。 -->
    <ProjectReference Include="..\..\src\SimpleLyrics.Core\SimpleLyrics.Core.csproj" />
  </ItemGroup>

</Project>
