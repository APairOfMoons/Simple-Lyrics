<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    包源固定为 nuget.org，并清空继承来的其他源，保证还原行为可预期、可审计。
    本机网络会把 api.nuget.org 重定向到 nuget.azure.cn（Azure 中国区镜像），
    这是网络层行为，此处无需改动 URL。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <config>
    <!-- 依赖包按目标框架分组，签名验证保持默认开启。 -->
    <add key="signatureValidationMode" value="require" />
  </config>

</configuration>
