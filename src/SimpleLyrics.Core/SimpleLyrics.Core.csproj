<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SimpleLyrics.Core —— 无 UI 依赖的纯逻辑层。
    包含：音频解码/播放封装、波形峰值生成与缓存、LRC 解析与生成、
          打轴编辑操作与撤销栈。
    刻意不引用任何 Avalonia 类型，以便用单元测试快速验证。
  -->
  <PropertyGroup>
    <RootNamespace>SimpleLyrics.Core</RootNamespace>
    <AssemblyName>SimpleLyrics.Core</AssemblyName>
    <!-- FFmpeg.AutoGen 绑定全部是指针 API，必须开启 unsafe。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- NAudio：播放输出与设备时钟。 -->
    <PackageReference Include="NAudio" Version="$(NAudioVersion)" />
    <!-- FFmpeg.AutoGen：解码为 PCM。原生 DLL 位于 third_party/ffmpeg/bin，见该目录 README.md。 -->
    <PackageReference Include="FFmpeg.AutoGen" Version="$(FFmpegAutoGenVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      探针需要读到播放缓存里的原始样本，才能核对「分块增量解码」与「一次性解码」
      是否逐位一致。这只放开给测试工具，不对外暴露。
    -->
    <InternalsVisibleTo Include="SimpleLyrics.Probe" />
  </ItemGroup>

</Project>
